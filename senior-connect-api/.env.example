# App
PORT=5000
NODE_ENV=development
API_PREFIX=api/v1

# Database (PostgreSQL)
# Local dev default: dockerized Postgres →
#   docker run -d --name senior-connect-db -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=senior_connect -p 5433:5432 postgres:16-alpine
DB_HOST=localhost
DB_PORT=5433
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_DATABASE=senior_connect
DB_SYNCHRONIZE=true

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_ACCESS_EXPIRES_IN=1d
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_EXPIRES_IN_MINUTES=5

# SMTP (optional - OTP is logged to console when not configured)
# For Gmail, SMTP_PASSWORD must be a 16-char App Password (not your account password).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# From address shown to recipients. Display name is always "Joinly".
EMAIL_FROM=

# Uploads (Cloudinary — get from your Cloudinary dashboard's "API Environment variable")
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
